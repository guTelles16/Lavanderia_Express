-- -----------------------------------------------------
-- 1. DDL: Criação do Esquema e Tabelas
-- -----------------------------------------------------
DROP DATABASE IF EXISTS lavanderia_express;
CREATE DATABASE lavanderia_express;
USE lavanderia_express;

CREATE TABLE Cliente (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    Nome VARCHAR(100) NOT NULL,
    Telefone VARCHAR(20) NOT NULL,
    Endereco VARCHAR(255) NOT NULL
);

CREATE TABLE Servico (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    Descricao VARCHAR(150) NOT NULL,
    PrecoUnitario DECIMAL(10, 2) NOT NULL
);

CREATE TABLE Pedido (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    ClienteID INT NOT NULL,
    Data DATETIME DEFAULT CURRENT_TIMESTAMP,
    DataPrevistaEntrega DATE,
    Status VARCHAR(50) DEFAULT 'Pendente',
    ValorTotal DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
    CONSTRAINT fk_pedido_cliente FOREIGN KEY (ClienteID) REFERENCES Cliente(ID)
);

-- armazenar o preço unitário histórico do item no momento do pedido.
CREATE TABLE Pedido_Servico (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    PedidoID INT NOT NULL,
    ServicoID INT NOT NULL,
    Quantidade INT NOT NULL DEFAULT 1,
    PrecoUnitario DECIMAL(10, 2) NOT NULL,
    CONSTRAINT fk_pedserv_pedido FOREIGN KEY (PedidoID) REFERENCES Pedido(ID) ON DELETE CASCADE,
    CONSTRAINT fk_pedserv_servico FOREIGN KEY (ServicoID) REFERENCES Servico(ID)
);

-- -----------------------------------------------------
-- 2. DQL: View para simplificar SELECTs no Java
-- -----------------------------------------------------
CREATE VIEW vw_detalhes_pedidos AS
SELECT 
    p.ID AS id_pedido,
    c.Nome AS cliente,
    c.Telefone AS telefone,
    s.Descricao AS servico,
    ps.Quantidade AS quantidade,
    ps.PrecoUnitario AS preco_unitario,
    (ps.Quantidade * ps.PrecoUnitario) AS subtotal,
    p.Status AS status_pedido,
    p.Data AS data_recebimento
FROM Pedido p
INNER JOIN Cliente c ON p.ClienteID = c.ID
INNER JOIN Pedido_Servico ps ON p.ID = ps.PedidoID
INNER JOIN Servico s ON ps.ServicoID = s.ID;

